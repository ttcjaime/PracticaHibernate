<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.jaimemendo.practica1ud3.view.cancion.CancionView">
  <grid id="27dc6" binding="mainPanel" layout-manager="CardLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="b6267" binding="panelCancion" layout-manager="FormLayout">
        <rowspec value="center:max(d;4px):noGrow"/>
        <rowspec value="top:4dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <rowspec value="top:4dlu:noGrow"/>
        <rowspec value="center:d:grow"/>
        <colspec value="fill:d:grow"/>
        <constraints>
          <card name="Card1"/>
        </constraints>
        <properties>
          <background color="-14803409"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="2d4f6" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <background color="-14013888"/>
              <foreground color="-14013888"/>
            </properties>
            <border type="none"/>
            <children>
              <grid id="eea70" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints/>
                <properties>
                  <background color="-14803409"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="1b030" class="javax.swing.JLabel">
                    <constraints/>
                    <properties>
                      <foreground color="-657931"/>
                      <text value="Titulo"/>
                    </properties>
                  </component>
                  <component id="5beb7" class="javax.swing.JTextField" binding="txtTituloCancion">
                    <constraints/>
                    <properties>
                      <minimumSize width="64" height="30"/>
                      <preferredSize width="150" height="30"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <grid id="fc70f" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints/>
                <properties>
                  <background color="-14803409"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="1e08d" class="javax.swing.JLabel">
                    <constraints/>
                    <properties>
                      <foreground color="-657931"/>
                      <text value="Duracion"/>
                    </properties>
                  </component>
                  <component id="2a724" class="javax.swing.JSpinner" binding="spinnerDuracion">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </grid>
              <grid id="14c85" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints/>
                <properties>
                  <background color="-14803409"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="7055f" class="javax.swing.JLabel">
                    <constraints/>
                    <properties>
                      <foreground color="-657931"/>
                      <text value="Disco"/>
                    </properties>
                  </component>
                  <component id="519ba" class="javax.swing.JComboBox" binding="comboDiscoCancion">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </grid>
            </children>
          </grid>
          <grid id="2e524" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <background color="-14013888"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="35d21" class="javax.swing.JButton" binding="btnAddCancion">
                <constraints/>
                <properties>
                  <background color="-9675545"/>
                  <foreground color="-657931"/>
                  <text value="AÑADIR"/>
